# ============================================
# Backend — Variáveis de ambiente
# ============================================
# Copia este ficheiro para .env e preenche os valores reais.
# Nunca committes o .env.

# Chave de API do Groq
# Obtém em: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Chave secreta para assinar tokens JWT
# Gera com: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=generate_a_random_secret_key_with_python_secrets

# Base de dados Turso (opcional)
# Se vazio, a app usa SQLite local (database.db).
# Se preenchido, liga à Turso.
# TURSO_URL=libsql://your-database.turso.io
# TURSO_TOKEN=your_turso_token_here